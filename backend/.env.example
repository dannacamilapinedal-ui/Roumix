PORT=3000
NODE_ENV=development

# Cadena de conexión a PostgreSQL en Supabase
# Supabase Dashboard -> botón "Connect" -> Connection string (Transaction pooler, puerto 6543)
DATABASE_URL=postgresql://postgres.[TU_PROYECTO_REF]:[TU_CONTRASENA]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Supabase Auth (validación de sesiones en el backend)
# Supabase Dashboard -> Project Settings -> API Keys
SUPABASE_URL=https://[TU_PROYECTO_REF].supabase.co
SUPABASE_ANON_KEY=[TU_CLAVE_ANON_O_PUBLISHABLE]

# Solo en producción: orígenes permitidos para CORS, separados por coma
# CORS_ORIGIN=https://roumix.ejemplo.com

# CAPTCHA (Cloudflare Turnstile): https://dash.cloudflare.com -> Turnstile -> Add widget
# Sin estas dos variables el CAPTCHA queda desactivado.
# TURNSTILE_SITE_KEY=0x...
# TURNSTILE_SECRET_KEY=0x...

# Dirección pública de la aplicación (enlace del correo para recuperar la contraseña).
# Si no se define, se usa la dirección desde la que se hizo la petición.
# APP_URL=https://roumix.onrender.com
